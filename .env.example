# Local development only. Never reuse these values anywhere real.
TENANTRY_HTTP_PORT=80
TENANTRY_AUTH_URL=http://auth.tenantry.localhost
# Tenants live at <slug>.<base domain>; signup lives at the base domain itself.
TENANTRY_BASE_DOMAIN=tenantry.localhost

# Host port for Postgres. Change it (and the two URLs at the bottom) if another Postgres uses 5432.
TENANTRY_PG_PORT=5432

# Loopback port for Keycloak, used by processes on the host (pnpm dev), which cannot resolve *.localhost.
TENANTRY_KC_PORT=8180
TENANTRY_AUTH_INTERNAL_URL=http://127.0.0.1:8180

POSTGRES_PASSWORD=dev-postgres-password
TENANTRY_OWNER_PASSWORD=dev-owner-password
TENANTRY_APP_PASSWORD=dev-app-password
KEYCLOAK_DB_PASSWORD=dev-keycloak-db-password

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-admin-password

# Where Caddy sends app traffic. `pnpm dev` points these at host.docker.internal.
WEB_UPSTREAM=web:80
PORTAL_UPSTREAM=portal:80
API_UPSTREAM=api:3000

# Used by the API and migrations when they run on the host (pnpm dev).
DATABASE_URL=postgres://tenantry_app:dev-app-password@127.0.0.1:5432/tenantry
DATABASE_OWNER_URL=postgres://tenantry_owner:dev-owner-password@127.0.0.1:5432/tenantry

# The API's Keycloak service account (organizations, members, tenant redirect URIs).
KEYCLOAK_BACKEND_CLIENT_ID=tenantry-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=dev-backend-secret

# Password-grant client that exists only in the local dev realm, for pnpm test:isolation.
TENANTRY_ISOLATION_CLIENT_SECRET=dev-isolation-secret

# Company login (ADR-0022), dev only: the local DNS server `pnpm ops domain verify` asks, and the
# secret of the stand-in company identity provider (realm corp-demo).
TENANTRY_DNS_PORT=1053
TENANTRY_DNS_SERVER=127.0.0.1:1053
CORP_DEMO_CLIENT_SECRET=dev-corp-demo-secret

# Password for the demo accounts `pnpm seed` creates. Local test accounts only.
SEED_PASSWORD=dev-seed-password

# The operator scripts' own Keycloak service account (pnpm ops): the API's never manages identity providers.
KEYCLOAK_OPS_CLIENT_ID=tenantry-ops
KEYCLOAK_OPS_CLIENT_SECRET=dev-ops-secret

# Enterprise realms (ADR-0010): the master-realm account that may only create realms, and where each
# realm's backend secret is kept (ADR-0023). dev-stack creates the account.
KEYCLOAK_PROVISIONER_CLIENT_ID=tenantry-provisioner
KEYCLOAK_PROVISIONER_CLIENT_SECRET=dev-provisioner-secret
# Relative to apps/api when the API runs on the host (pnpm dev); Docker mounts the same folder.
TENANTRY_SECRETS_DIR=../../.secrets
# The API container's user and group on Linux and macOS; `pnpm dev:stack` sets them to yours.
# TENANTRY_UID=1000
# TENANTRY_GID=1000
# Customer apps each enterprise workspace may register (ADR-0011).
TENANTRY_MAX_APPS_PER_TENANT=20
# The welcome page offers these workspaces to try (Phase 6a). The seed makes them; leave empty in production.
VITE_DEMO_WORKSPACES=acme,globex,initech
