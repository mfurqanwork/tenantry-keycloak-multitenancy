# Copy to .env and fill from the app's connection details (pnpm seed writes .env for "Initech HR").
ISSUER=http://auth.tenantry.localhost/realms/ent-initech
CLIENT_ID=app-00000000
CLIENT_SECRET=
# Optional: where this process reaches Keycloak when the issuer's host does not resolve here.
AUTH_INTERNAL_URL=http://127.0.0.1:8180
