{
  "name": "@tenantry/login-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:jar": "pnpm build && keycloakify build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && stylelint \"src/**/*.scss\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@carbon/react": "^1.119.0",
    "@tenantry/ui": "workspace:*",
    "keycloakify": "11.16.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "sass": "^1.107.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
