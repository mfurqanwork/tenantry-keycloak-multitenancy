# Serves the built SPA; every unknown path falls back to index.html for client-side routing.
:80 {
	root * /srv
	# index.html is checked again on every load, so an update reaches the browser at once; the files under
	# /assets/ carry a hash in their names and never change.
	@page not path /assets/*
	header @page Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
