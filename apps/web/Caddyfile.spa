# Serves the built SPA; every unknown path falls back to index.html for client-side routing.
:80 {
	root * /srv
	# index.html is checked again on every load, so an update reaches the browser at once; the files under
	# /assets/ carry a hash in their names and never change.
	@page not path /assets/*
	header @page Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# A missing file (a name with an extension) or a dotfile path is a real 404, not the app: scanners
	# asking for /.env, /.git/config or /wp-login.php get nothing that looks like a hit.
	@missing {
		not file
		path_regexp \.[A-Za-z0-9]+$|/\.
	}
	handle @missing {
		respond 404
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
