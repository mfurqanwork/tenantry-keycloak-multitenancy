{
  "name": "@tenantry/keycloak-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "default": "./dist/dev/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test-integration",
    "test": "vitest run",
    "test:isolation": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@tenantry/auth": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
