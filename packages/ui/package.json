{
  "name": "@tenantry/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.scss": "./src/styles/index.scss"
  },
  "sideEffects": [
    "*.scss"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && stylelint \"src/**/*.scss\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.91.0",
    "@carbon/react": "^1.119.0",
    "@ibm/plex": "6.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@tenantry/brand": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "sass": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vitest": "^5.0.5"
  }
}
