{
  "name": "tenantry",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/lib/*.test.mjs\"",
    "format": "prettier --write .",
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:infra": "node scripts/dev-stack.mjs --infra",
    "dev": "node scripts/dev-stack.mjs --infra && turbo run dev",
    "smoke": "node scripts/smoke.mjs",
    "stack:down": "docker compose -f infra/docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
