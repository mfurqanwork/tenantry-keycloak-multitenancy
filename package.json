{
  "name": "tenantry",
  "private": true,
  "version": "0.6.1",
  "license": "MIT",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/lib/*.test.mjs\"",
    "format": "prettier --write .",
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:infra": "node scripts/dev-stack.mjs --infra",
    "dev": "node scripts/dev-stack.mjs --infra && turbo run dev",
    "smoke": "node scripts/smoke.mjs",
    "stack:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "test:isolation": "turbo run test:isolation --concurrency=1",
    "ops": "turbo run build --filter=@tenantry/ops^... --output-logs=errors-only && pnpm --filter @tenantry/ops --silent run ops",
    "seed": "pnpm ops seed",
    "example:customer-app": "pnpm --filter @tenantry/customer-app --silent start",
    "brand:icons": "node scripts/brand-icons.mjs",
    "release": "node scripts/release.mjs",
    "smoke:live": "node scripts/smoke-live.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
