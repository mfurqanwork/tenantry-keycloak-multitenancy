{
  "realm": "platform",
  "displayName": "Tenantry",
  "loginTheme": "tenantry",
  "enabled": true,
  "organizationsEnabled": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "sslRequired": "external",
  "registrationAllowed": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@tenantry.localhost",
    "fromDisplayName": "Tenantry"
  },
  "clients": [
    {
      "clientId": "tenantry-web",
      "name": "Tenantry web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://tenantry.localhost/*", "http://tenantry.localhost:8080/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "tenantry-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tenantry-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "organization groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-group-membership-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tenantry-portal",
      "name": "Tenantry portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "tenantry-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tenantry-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "organization groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-group-membership-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tenantry-backend",
      "name": "Tenantry backend",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-backend-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false
    },
    {
      "clientId": "tenantry-ops",
      "name": "Tenantry operator scripts",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-ops-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "tenantry-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tenantry-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tenantry-isolation-tests",
      "name": "Isolation tests (local dev realm only)",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-isolation-secret",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "tenantry-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tenantry-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "organization groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-group-membership-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-tenantry-backend",
      "enabled": true,
      "serviceAccountClientId": "tenantry-backend",
      "clientRoles": {
        "realm-management": [
          "manage-realm",
          "view-users",
          "manage-users",
          "manage-clients",
          "view-identity-providers"
        ]
      }
    },
    {
      "username": "service-account-tenantry-ops",
      "enabled": true,
      "serviceAccountClientId": "tenantry-ops",
      "clientRoles": {
        "realm-management": [
          "manage-realm",
          "view-users",
          "manage-users",
          "manage-clients",
          "manage-identity-providers",
          "view-identity-providers"
        ]
      }
    }
  ]
}
