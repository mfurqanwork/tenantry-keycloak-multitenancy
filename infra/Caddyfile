# Local routing. Caddy's * matches one label, so portal and web hosts never overlap.
{
	auto_https off
}

http://auth.tenantry.localhost:{$TENANTRY_HTTP_PORT} {
	reverse_proxy keycloak:8080
}

http://mail.tenantry.localhost:{$TENANTRY_HTTP_PORT} {
	reverse_proxy mailpit:8025
}

# The apex host serves signup from the web app.
http://tenantry.localhost:{$TENANTRY_HTTP_PORT} {
	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}
	handle {
		reverse_proxy {$WEB_UPSTREAM}
	}
}

http://*.portal.tenantry.localhost:{$TENANTRY_HTTP_PORT} {
	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}
	handle {
		reverse_proxy {$PORTAL_UPSTREAM}
	}
}

http://*.tenantry.localhost:{$TENANTRY_HTTP_PORT} {
	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}
	# The workspace's SCIM address for its directory (ADR-0024).
	handle /scim/* {
		reverse_proxy {$API_UPSTREAM}
	}
	handle {
		reverse_proxy {$WEB_UPSTREAM}
	}
}
